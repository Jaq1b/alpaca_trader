# Alpaca credentials (required to run the bot / live metrics report)
ALPACA_API_KEY="your_paper_key_here"
ALPACA_SECRET_KEY="your_paper_secret_here"

# Optional: override config.yaml paper_trading (default is true / paper)
# ALPACA_PAPER_TRADING=true

# Optional: override path to config.yaml (default: ./config.yaml)
# TRADING_CONFIG=config.yaml

# Optional: override SQLite / metrics data directory (default: trading_data)
# TRADING_DATA_DIR=trading_data
